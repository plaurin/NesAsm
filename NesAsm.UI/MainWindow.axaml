<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="256" d:DesignHeight="340"
        Width="768" Height="743"
        x:Class="NesAsm.UI.MainWindow"
        Title="NesAsm.UI">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Name="RecentRomsMenuItem" Header="_Recent ROMs" />
            </MenuItem>
        </Menu>
        <StackPanel>
            <Label Name="FrameCounter" />
            <Image Name="Image" Width="768" Height="720" RenderOptions.BitmapInterpolationMode="None" />
        </StackPanel>
    </DockPanel>
</Window>
