<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="256" d:DesignHeight="340"
        SizeToContent="WidthAndHeight" CanResize="False"
        x:Class="NesAsm.UI.MainWindow"
        Title="NesAsm.UI">
    <DockPanel>
        <Menu Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Name="RecentRomsMenuItem" Header="_Recent ROMs" />
                <MenuItem Name="CustomRomsMenuItem" Header="_Custom ROMs" />
                <MenuItem Name="Mapper0RomsMenuItem" Header="_Mapper 0" />
            </MenuItem>
            <MenuItem Header="_Database">
                <MenuItem Name="CheatsMenuItem" Header="_Cheats" />
            </MenuItem>
        </Menu>
        <StackPanel>
            <Label Name="FrameCounter" />
            <Grid>
                <Image Name="Image" Width="768" Height="720" RenderOptions.BitmapInterpolationMode="None" />
                <Border Name="PauseOverlay" Background="#80888888" IsVisible="False">
                    <TextBlock Text="Pause" FontSize="48" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
