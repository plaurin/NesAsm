<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NesAsm.UI.SaveStateView"
             x:Name="root">

    <StackPanel>
        <Border BorderThickness="2"
                BorderBrush="Black"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Image Name="SavePreview" />
        </Border>
        <TextBlock HorizontalAlignment="Center" Name="Timestamp">📆 2026-11-20 22:19</TextBlock>
        <TextBlock HorizontalAlignment="Center" Name="PlayTime">⏱43m25s</TextBlock>
    </StackPanel>
    
</UserControl>